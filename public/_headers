# Cloudflare Static Assets Headers

# Global Security & Integrity Headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Hashed assets in /assets/ (immutable for 1 year)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images in /images/ (immutable for 1 year)
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts (if any)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Text & LLM Context files
/*.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# HTML documents must always revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
