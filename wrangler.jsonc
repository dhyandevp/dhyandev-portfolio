{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dhyandev-portfolio",
  "compatibility_date": "2024-11-15",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "dhyandev.sbs",
      "custom_domain": true
    },
    {
      "pattern": "links.dhyandev.sbs",
      "custom_domain": true
    }
  ]
}

